# Rules are applied in order and later matches win, so the defaults below are
# overridden by the more specific blocks that follow.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; font-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  # Prerendered pages must revalidate so a deploy is visible immediately.
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output is immutable — cache it hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored, content-stable webfonts.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

# The worker script decides what is cached, so it must never be stale itself.
/sw.js
  Cache-Control: no-cache
